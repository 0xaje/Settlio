{
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@foundry-rs/forge": "^1.7.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "solc": "0.8.29",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "name": "settlio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:contracts": "node script/compile.cjs",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "setup:reactive": "node script/setup-reactive.cjs",
    "preflight": "node script/preflight.cjs",
    "deploy:testnet": "node script/deploy-testnet.cjs",
    "dev": "vite apps/web --host 0.0.0.0",
    "build:web": "node script/export-abi.cjs && tsc -p apps/web/tsconfig.json && vite build apps/web",
    "preview:web": "vite preview apps/web --host 0.0.0.0",
    "healthcheck": "node script/healthcheck.cjs",
    "verify:quote": "node script/verify-quote.cjs",
    "preflight:m2": "node script/m2.cjs preflight",
    "plan:m2": "node script/m2.cjs plan",
    "deploy:m2": "node script/m2.cjs deploy",
    "verify:m2": "node script/m2.cjs verify",
    "diagnose:cron": "node script/diagnose-cron.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ethers": "^6.17.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
