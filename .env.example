# Set locally and keep private. This file deliberately contains no key.
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org
LASNA_RPC=https://lasna-rpc.rnk.dev
# Constructor funding is separate from refundable customer deposits.
REACTIVE_FUND=0.1
CALLBACK_FUND=0.001

# Browser settings belong in apps/web/.env.local (Vite exposes VITE_* publicly).
# Never put a private key or confidential RPC credential in a VITE_* setting.
# VITE_ESCROW_ADDRESS=<actual deployed escrow>
# VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
# VITE_LASNA_RPC=https://lasna-rpc.rnk.dev
